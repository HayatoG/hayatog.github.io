---
import { projects, itchGames } from '../data/portfolio';
---
<section class="block" id="projetos">
  <div class="sec-label reveal"><span class="torii">⛩</span> A Obra <span class="torii">⛩</span></div>
  <div class="projects reveal" data-reveal-group>
    {projects.map((p) => (
      <a class="proj" data-stagger href={p.url} target="_blank" rel="noopener">
        <span class="arrow">↗</span>
        <h3><span class="torii">⛩</span> {p.name}</h3>
        <p set:html={p.desc} />
        <div class="ptags">{p.tags} — ★ {p.stars}</div>
      </a>
    ))}
  </div>
  <div class="games reveal">
    {itchGames.map((g) => (
      <div class="game">
        <h3><span class="torii">⛩</span> {g.name}</h3>
        <p set:html={g.desc} />
        <iframe frameborder="0" src={`https://itch.io/embed/${g.embedId}`} width="552" height="167" loading="lazy" title={`${g.name} no itch.io`}>
          <a href={g.url}>{g.name} by hayatog</a>
        </iframe>
      </div>
    ))}
  </div>
</section>
